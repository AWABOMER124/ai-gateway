# ================================================================
# .env additions for Awab Personal AI Office
# Append these to /root/ai-gateway/.env on the server
# ================================================================

# ── Security ─────────────────────────────────────────────────────
# Legacy shared secret — full access to every /agent/* /email/* /olivery/*
# /files/* /approvals/* /waslak/* endpoint via X-API-Key: <value>. Kept for
# existing Telegram/n8n callers. As of 2026-08-04, external integrations
# should instead get a SCOPED key issued from /dashboard/api-keys (see the
# Dashboard section below) — narrower blast radius, individually revocable,
# tracked (last_used_at). Both mechanisms work side by side.
GATEWAY_API_KEY=change-this-to-a-strong-secret

# ── Olivery/EasyDelivery API ─────────────────────────────────────
OLIVERY_BASE_URL=https://easydelivery.olivery.io
OLIVERY_DB=easydelivery
OLIVERY_LOGIN=0594997315
OLIVERY_PASSWORD=12345

# ── SMTP (required for real email sending via /approvals + Executor) ──
# Office365: smtp.office365.com, port 587, an App Password (not the login password —
# generate one at https://account.microsoft.com/security under "App passwords").
# Leave empty to disable sending (drafts will be saved but not sent).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=awab@easydlivery.com

# ── Waslak Merchant OS API ─────────────────────────────────────────
# API key scoped to one Distributor, issued from /distributor/settings/api-keys.
# Required scopes: stores:draft, merchants:read, orders:read.
WASLAK_BASE_URL=https://<your-waslak-merchant-os-domain>
WASLAK_API_KEY=wsk_live_...

# ── Dashboard (small-team login + scoped integration API keys) ─────
# Generate via: python3 -c "import secrets; print(secrets.token_hex(32))"
# Rotating this instantly invalidates every logged-in dashboard session.
DASHBOARD_SESSION_SECRET=
# Set to false ONLY for local/non-HTTPS testing — keep true in production.
DASHBOARD_COOKIE_SECURE=true

# ── OpenAI spend guardrail ─────────────────────────────────────────
# Soft daily cap (USD) enforced across every OpenAI call in this project —
# agents (supervisor/reviewer/all agents) AND the RAG /ask + /search pipeline.
# 0 or negative disables the cap (usage is still logged either way, to
# openai_usage_log — see migrations/008_openai_usage.sql).
OPENAI_DAILY_SPEND_LIMIT_USD=10.0

# ── These should already exist in your .env ──────────────────────
# DATABASE_URL=postgresql://...
#   As of 2026-08-02 this points at the internal container hostname
#   (awab-ai-postgres:5432), not host.docker.internal:5438 — the DB's host
#   port is now bound to 127.0.0.1 only (was 0.0.0.0, publicly reachable).
#   ai-gateway reaches it via the shared awab-ai-postgres_default Docker
#   network (see docker-compose.yml). Only use host.docker.internal:5438
#   again if you deliberately revert that network join.
# OPENAI_API_KEY=sk-proj-...
# CHAT_MODEL=gpt-4.1-mini
