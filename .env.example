# =====================================================
# .env.example — انسخ إلى .env وأضف قيمك الحقيقية
# لا ترفع .env إلى Git أبداً
# =====================================================

# قاعدة البيانات — PostgreSQL + pgvector على السيرفر
# عبر SSH Tunnel: ssh -L 5438:127.0.0.1:5438 root@YOUR_SERVER_IP
DATABASE_URL=postgresql://awab_ai:YOUR_PASSWORD@127.0.0.1:5438/awab_ai

# OpenAI — مطلوب للـ embeddings والإجابات
OPENAI_API_KEY=

# نموذج الـ embeddings (لا تغيّره إلا لو أعدت الـ ingest)
EMBEDDING_MODEL=text-embedding-3-small

# نموذج الدردشة
# بدائل: gpt-4.1 / gpt-4o / gpt-4o-mini
CHAT_MODEL=gpt-4.1-mini

# عدد المصادر الافتراضي في كل بحث
DEFAULT_TOP_K=6
